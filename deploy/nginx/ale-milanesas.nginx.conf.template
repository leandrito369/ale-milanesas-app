# B4-02D: nginx en el MISMO HOST que Spring Boot con -Dspring.profiles.active=prod
# Reemplazar @ALE_HOST@ por el FQDN validado (NO URL). Nunca exponer :8080.
# TLS real/certificados: provisionados externamente, sin llaves en Git.
worker_processes 1;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_max_body_size 256k;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;

    # Solo POST se cuenta; GET /web/login muestra formulario sin consumir cuota.
    map $request_method $ale_login_ip {
        default "";
        POST $binary_remote_addr;
    }
    # Estado compartido entre los workers del UNICO nginx frontal.
    limit_req_zone $ale_login_ip zone=ale_login_ip:10m rate=1r/s;
    limit_req_status 429;
    limit_req_log_level warn;

    # Nunca aceptar contraseñas por HTTP claro, ni redirigir bodies secretos.
    server {
        listen 80 default_server;
        server_name _;
        return 444;
    }
    server {
        listen 443 ssl default_server;
        server_name @ALE_HOST@;
        if ($host != @ALE_HOST@) { return 421; }
        ssl_certificate /etc/ale/tls/fullchain.pem;
        ssl_certificate_key /etc/ale/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;

        # Backend solo loopback y un proceso: PostgreSQL singleton lock.
        # Reemplazar valores del cliente, NO concatenar X-Forwarded-For no fiable.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";

        location = /api/v1/auth/login {
            limit_req zone=ale_login_ip burst=3 nodelay;
            proxy_pass http://127.0.0.1:8080;
        }
        location = /web/login {
            limit_req zone=ale_login_ip burst=3 nodelay;
            proxy_pass http://127.0.0.1:8080;
        }
        location / {
            proxy_pass http://127.0.0.1:8080;
        }
    }
}
