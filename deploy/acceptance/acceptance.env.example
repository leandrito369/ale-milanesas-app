# Plantilla para /etc/ale/acceptance.env (root:root, modo 0600, fuera de Git).
# Completar exclusivamente en el host aislado. No cargar esta plantilla sin editar.
SPRING_PROFILES_ACTIVE=prod
ALE_PUBLIC_ORIGIN=https://REEMPLAZAR_FQDN
ALE_DB_HOST=127.0.0.1
ALE_DB_PORT=5432
ALE_DB_NAME=ale_milanesas_acceptance
ALE_DB_USER=ale_acceptance
ALE_DB_PASSWORD=REEMPLAZAR_EN_HOST
ALE_HTTP_PORT=8080
# La unidad systemd fija las dos banderas comerciales a false por argumento.
